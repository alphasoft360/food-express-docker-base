# Enatega dev environment. Copy to .env (the scripts do this on first run).
# Categories: [LOCAL] local dev setting, [PUBLIC] value is shipped to the browser/phone,
# [SECRET] never commit a real value, [OPTIONAL] leave empty to keep upstream default.

# ---------------------------------------------------------------- network [LOCAL]
# LAN IP of this computer, used in the Metro QR codes the phone scans.
# Leave empty: scripts auto-detect it on every run (recommended; Wi-Fi IPs change).
HOST_LAN_IP=

# Upstream monorepo checkout, relative to docker-base/ (or absolute).
REPO_DIR=../repositories/food-delivery-multivendor
# Cloned automatically by the scripts if REPO_DIR is missing.
UPSTREAM_REPO=https://github.com/enatega/food-delivery-multivendor.git

# ---------------------------------------------------------------- ports [LOCAL]
# Metro ports are published 1:1 (Expo embeds the port in the QR code).
CUSTOMER_METRO_PORT=8081
RIDER_METRO_PORT=8082
STORE_METRO_PORT=8083
ADMIN_PORT=3001
WEB_PORT=3002
SV_ADMIN_PORT=3003
# Browser page with scannable QR codes + APK downloads (enatega-qr service).
QR_PAGE_PORT=8090

# ---------------------------------------------------------------- runtime [LOCAL]
# Node image for all apps. Upstream .nvmrc says 20.16.0, but the store app
# (Expo SDK 54 / RN 0.81 / Metro 0.83) requires >= 20.19.4, so 20.19.x is used.
NODE_VERSION=20.19.5
# true = poll for file changes (Next.js/webpack only). Needed when the repo sits
# on a Windows NTFS drive (/mnt/c, C:\). Metro cannot poll - see README.
FILE_WATCH_POLLING=false
# Extra `expo start` flags. Empty = upstream behaviour: Expo auto-targets the
# development build because expo-dev-client is installed. --go forces Expo Go.
# (Or press `s` in the attached Expo terminal to switch at runtime.)
CUSTOMER_EXPO_FLAGS=
RIDER_EXPO_FLAGS=
STORE_EXPO_FLAGS=
# Linux only: files created in the repo get this owner. Scripts fill it from `id -u/-g`.
HOST_UID=
HOST_GID=

# ---------------------------------------------------------------- backend [PUBLIC]
# The Enatega API is proprietary; there is no local backend to run. These are the
# upstream hosted endpoints. Web apps require them (no default in their source).
API_URL=https://aws-server-v2.enatega.com/
API_WS_URL=wss://aws-server-v2.enatega.com/
SV_API_URL=https://enatega-multivendor-api-production-9b09.up.railway.app/
SV_API_WS_URL=wss://enatega-multivendor-api-production-9b09.up.railway.app/
# Rider app is the only mobile app with an env override for the multi-vendor API.
# (Customer & store apps hardcode it in environment.config.js / environment.ts.)
RIDER_GRAPHQL_URL=https://aws-server-v2.enatega.com/graphql
RIDER_WS_GRAPHQL_URL=wss://aws-server-v2.enatega.com/graphql

# ---------------------------------------------------------------- keys [OPTIONAL][SECRET]
# Maps render blank without these. Get them from Google Cloud Console. Never commit.
GOOGLE_MAPS_API_KEY_WEB=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
# Customer app Google sign-in (EXPO_PUBLIC_GOOGLE_*).
CUSTOMER_GOOGLE_WEB_CLIENT_ID=
CUSTOMER_GOOGLE_ANDROID_CLIENT_ID=
CUSTOMER_GOOGLE_IOS_CLIENT_ID=
CUSTOMER_GOOGLE_IOS_REVERSED_CLIENT_ID=
# Admin: key used to decrypt encrypted config values from the API (NEXT_PUBLIC_ENCRYPTION_KEY).
# Issued with an Enatega backend licence; not public.
ADMIN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- android builder [LOCAL]
# ABIs to compile for scripts/build-android.sh. arm64-v8a covers ~all real phones.
ANDROID_ARCHS=arm64-v8a
# Build JVM heap / parallelism. Peak use ~4.5 GB: stop the apps first on an 8 GB Docker VM.
GRADLE_JVMARGS=-Xmx3g -XX:MaxMetaspaceSize=1g
GRADLE_WORKERS=2
